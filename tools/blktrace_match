#!/usr/bin/env python3
"""
Match a sun2_blktrace readout against the files the machine was copying.

    tools/blktrace_match TRACE --source adb=/path/adb.bin [--source ...]
                               [--lba-offset N]

`tools/deca_blktrace.tcl' says *where* the machine wrote and hands back a
16-bit fold of each sector.  This says *what* it wrote, by folding the source
files the same way and looking the signatures up.

The two questions it separates are the ones the whole instrument exists for:

  * a block written to the wrong LBA -- the run's own addresses would not line
    up with a contiguous stretch of a source file, and
  * the right block holding the wrong bytes -- the addresses line up and
    individual sectors do not match, in which case a sector whose signature
    belongs to *another* file names where the stale data came from.

Two cautions are built in rather than left to the reader.

An all-zero sector folds to 0, and a filesystem is full of them, so a zero
signature identifies nothing and is reported separately instead of being
counted as a match.  And a 16-bit fold collides: with W writes against S
candidate source sectors roughly W*S/65536 false matches are expected by
chance, so the header prints that number.  A handful of "foreign" sectors below
it is noise, which is exactly the trap that cost this project a wrong
conclusion once already.
"""
import argparse, re, sys, collections

def fold(data):
    s = 0
    for b in data:
        s = ((s << 1) | (s >> 15)) & 0xFFFF
        s = (s + b) & 0xFFFF
    return s

ap = argparse.ArgumentParser()
ap.add_argument("trace")
ap.add_argument("--source", action="append", default=[], metavar="NAME=FILE")
ap.add_argument("--lba-offset", type=lambda x: int(x, 0), default=0,
                help="subtract this from every LBA (the partition's start on the card)")
ap.add_argument("--run-min", type=int, default=4,
                help="ignore write runs shorter than this many sectors")
a = ap.parse_args()

# ---- the sources, folded per 512-byte sector -------------------------------
sig2src = collections.defaultdict(list)
srcsec  = {}
for spec in a.source:
    if "=" not in spec:
        sys.exit("--source wants NAME=FILE, got %r" % spec)
    name, path = spec.split("=", 1)
    d = open(path, "rb").read()
    secs = [fold(d[i:i+512].ljust(512, b"\0")) for i in range(0, len(d), 512)]
    srcsec[name] = secs
    for n, s in enumerate(secs):
        sig2src[s].append((name, n))
nsrc = sum(len(v) for v in srcsec.values())

# ---- the trace -------------------------------------------------------------
rows = []
for line in open(a.trace):
    m = re.match(r"#(\d+)\s+(\w)\s+lba ([0-9a-f]+)\s+sig ([0-9a-f]+)", line)
    if m:
        rows.append((int(m.group(1)), m.group(2), int(m.group(3), 16),
                     int(m.group(4), 16)))
if not rows:
    sys.exit("no trace entries in %s" % a.trace)

w = [r for r in rows if r[1] == "W"]
print("trace: %d entries, %d writes; %d source sectors over %d files"
      % (len(rows), len(w), nsrc, len(srcsec)))
if nsrc:
    print("       expect ~%.0f false signature matches by chance (16-bit fold)"
          % (len(w) * nsrc / 65536.0))
print()

runs, cur = [], [w[0]]
for prev, nxt in zip(w, w[1:]):
    if nxt[2] == prev[2] + 1 and nxt[0] == prev[0] + 1:
        cur.append(nxt)
    else:
        runs.append(cur); cur = [nxt]
runs.append(cur)

for r in runs:
    if len(r) < a.run_min:
        continue
    base = r[0][2] - a.lba_offset
    # Best alignment: which source, at which sector offset, matches most.
    best = (0, None, None)
    for name, secs in srcsec.items():
        for off in range(0, max(1, len(secs) - len(r) + 1)):
            hit = sum(1 for i in range(len(r))
                      if r[i][3] != 0 and off + i < len(secs)
                      and r[i][3] == secs[off + i])
            if hit > best[0]:
                best = (hit, name, off)
    hit, name, off = best
    nz = sum(1 for x in r if x[3] != 0)
    head = "  sec %8d  %3d sectors (%d non-zero)" % (base, len(r), nz)
    if not name:
        print(head + "   no source alignment")
        continue
    print(head + "   %s sectors %d..%d : %d/%d match"
          % (name, off, off + len(r) - 1, hit, nz))
    for i, x in enumerate(r):
        if x[3] == 0 or (off + i < len(srcsec[name]) and x[3] == srcsec[name][off+i]):
            continue
        who = [c for c in sig2src.get(x[3], []) if c != (name, off + i)]
        tag = ("holds %s sector %d" % who[0]) if len(who) == 1 else \
              ("ambiguous: " + ", ".join("%s/%d" % c for c in who[:3])) if who else \
              "matches no source sector"
        print("      sec %8d  should be %s %d  ->  %s"
              % (base + i, name, off + i, tag))
