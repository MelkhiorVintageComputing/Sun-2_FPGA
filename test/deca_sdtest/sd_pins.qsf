# Pins for the standalone micro-SD test.  Copied from syn/deca_pins.qsf rather
# than sourced from it, because that file assigns the whole machine's pinout and
# this design has ten pins.  Locations are DECA_User_manual.pdf Table 3-21;
# polarities and the translator recipe are Inputs/doc/DECA_board/Tutorials/
# Porting-Cores/README.md.  Nothing here is inferred.

set_location_assignment PIN_M8 -to MAX10_CLK1_50
set_instance_assignment -name IO_STANDARD "2.5 V" -to MAX10_CLK1_50

set_location_assignment PIN_T20 -to SD_CLK        ;# SCK
set_location_assignment PIN_T21 -to SD_CMD        ;# MOSI
set_location_assignment PIN_R18 -to SD_MISO       ;# DAT0
set_location_assignment PIN_R20 -to SD_CS_N       ;# DAT3, used as chip select
set_location_assignment PIN_T18 -to SD_DAT1       ;# unused in SPI mode, driven
set_location_assignment PIN_T19 -to SD_DAT2       ;#   high rather than reserved
set_location_assignment PIN_P13 -to SD_SEL        ;# card VCCIO select, 3.3 V pin
set_location_assignment PIN_U22 -to SD_CMD_DIR
set_location_assignment PIN_T22 -to SD_D0_DIR
set_location_assignment PIN_U21 -to SD_D123_DIR
foreach p {SD_CLK SD_CMD SD_MISO SD_CS_N SD_DAT1 SD_DAT2 \
           SD_CMD_DIR SD_D0_DIR SD_D123_DIR} {
    set_instance_assignment -name IO_STANDARD "1.5 V" -to $p
}

# An SD card releases MISO between transfers and blk_sd reads the line while it
# is released, so the pull-up is load-bearing rather than tidy.
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to SD_MISO

set_location_assignment PIN_C7 -to LED[0]
set_location_assignment PIN_C8 -to LED[1]
set_location_assignment PIN_A6 -to LED[2]
set_location_assignment PIN_B7 -to LED[3]
set_location_assignment PIN_C4 -to LED[4]
set_location_assignment PIN_A5 -to LED[5]
set_location_assignment PIN_B4 -to LED[6]
set_location_assignment PIN_C5 -to LED[7]
foreach i {0 1 2 3 4 5 6 7} {
    set_instance_assignment -name IO_STANDARD "1.2 V" -to LED[$i]
}
